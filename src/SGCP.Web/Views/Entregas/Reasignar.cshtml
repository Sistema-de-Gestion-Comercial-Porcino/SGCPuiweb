@model ReasignarFormViewModel
@{ViewData["Title"]="Reasignar entrega";}
<div class="page-head">
<div><span class="eyebrow">ENTREGAS</span>
<h1>Reasignar entrega</h1>
<p>@Model.Descripcion</p>
</div>
</div>
<div class="notice" role="note">Reasignar cambia la versión de la entrega. Si el responsable anterior ya había capturado la recepción sin señal, esa captura llegará en <b>conflicto</b> y una persona tendrá que revisarla.</div>
<section class="card form-card">
<form method="post">
<div asp-validation-summary="All" class="validation" role="alert"></div>
<input asp-for="Id" type="hidden"/><input asp-for="VersionActual" type="hidden"/><input asp-for="Descripcion" type="hidden"/>
<div class="form-grid">
<div class="field"><label asp-for="ResponsableId">Nuevo responsable</label><select asp-for="ResponsableId" required>@foreach(var r in Model.Responsables){<option value="@r.Id">@r.Nombre</option>}</select></div>
<div class="field"><label asp-for="RutaId">Ruta</label><select asp-for="RutaId"><option value="">Sin ruta</option>@foreach(var r in Model.Rutas){<option value="@r.Id">@r.Codigo · @r.Zona</option>}</select></div>
<div class="field wide"><label asp-for="Motivo">Motivo</label><textarea asp-for="Motivo" rows="3" maxlength="1000" required></textarea><span asp-validation-for="Motivo" class="validation"></span></div>
</div>
<div class="form-actions"><a class="button secondary" asp-action="Index">Cancelar</a><button class="button" type="submit">Reasignar</button></div>
</form>
</section>
