@model SenasViewModel
@{ViewData["Title"]="Señas";var p=Model.Pedido;var n=Model.Nueva;}
<div class="page-head">
<div><span class="eyebrow">COBRANZA · RF-19</span>
<h1>Señas de @p.Codigo</h1>
<p>@p.Cliente. Una seña es dinero recibido por adelantado: se aplica una sola vez a un cargo del pedido.</p>
</div><a class="button secondary" href="/Pedidos/Detalle/@p.Id">Volver al pedido</a>
</div>
<div class="notice" role="note">Si una seña se cancela, se registra el <b>acuerdo de resolución</b>. El sistema no devuelve ni retiene dinero automáticamente.</div>
<section class="card">
<h2>Señas registradas</h2>
@if(Model.Senas.Count==0){<p class="muted">Este pedido no tiene señas.</p>}else{<div class="table-wrap">
<table>
<thead><tr><th>Referencia</th><th>Fecha</th><th>Medio</th><th>Importe</th><th>Situación</th><th>Acciones</th></tr></thead>
<tbody>@foreach(var s in Model.Senas){var pago=Model.Pagos.GetValueOrDefault(s.PagoId);<tr>
<td>@pago?.ReferenciaUnica</td>
<td>@(pago is null?"—":Hora.Mostrar(pago.Fecha))</td>
<td>@pago?.Medio</td>
<td>Bs @(pago?.Importe.ToString("N2"))</td>
<td>@if(s.ResueltaEn is not null){<span class="badge muted-badge">Con acuerdo de resolución</span><small>@s.AcuerdoResolucion</small>}else if(pago?.Anulado==true){<span class="badge muted-badge">Pago anulado</span>}else{<span class="badge">Registrada</span>}</td>
<td>@if(s.ResueltaEn is null&&pago?.Anulado!=true){<form method="post" asp-action="AplicarSena" class="row-actions"><input type="hidden" name="id" value="@s.Id"/><input type="hidden" name="pedidoId" value="@p.Id"/><select name="cargoId" required aria-label="Cargo al que se aplica"><option value="">Aplicar a…</option>@foreach(var c in Model.Cargos.Where(x=>x.Saldo>0)){<option value="@c.CargoId">@c.Concepto · saldo Bs @c.Saldo.ToString("N2")</option>}</select><button class="button secondary small" type="submit">Aplicar</button></form><a class="text-link" href="/Cobranza/Resolver/@s.Id?pedidoId=@p.Id">Registrar acuerdo</a>}</td>
</tr>}</tbody>
</table>
</div><p class="hint">Si la seña ya se aplicó, el sistema lo rechaza y lo avisa: no se aplica dos veces.</p>}
</section>
<section class="card form-card">
<h2>Registrar seña</h2>
<form method="post">
<div asp-validation-summary="All" class="validation" role="alert"></div>
<input asp-for="Nueva.PedidoId" type="hidden"/>
<div class="form-grid">
<div class="field"><label asp-for="Nueva.ReferenciaUnica">Referencia</label><input asp-for="Nueva.ReferenciaUnica" maxlength="80" required/></div>
<div class="field"><label asp-for="Nueva.Importe">Importe · Bs</label><input asp-for="Nueva.Importe" type="number" min="0.01" step="0.01" value="@(n.Importe==0?"":n.Importe.ToString(System.Globalization.CultureInfo.InvariantCulture))" required/><span asp-validation-for="Nueva.Importe" class="validation"></span></div>
<div class="field"><label asp-for="Nueva.Medio">Medio</label><input asp-for="Nueva.Medio" maxlength="80" required/></div>
<div class="field"><label asp-for="Nueva.Fecha">Fecha · Bolivia</label><input asp-for="Nueva.Fecha" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" required/></div>
</div>
<div class="form-actions"><button class="button" type="submit">Registrar seña</button></div>
</form>
</section>
