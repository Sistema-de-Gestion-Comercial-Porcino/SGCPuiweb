@model CondicionFormViewModel
@{ViewData["Title"]="Condición de pago";var p=Model.Pedido;}
<div class="page-head">
<div><span class="eyebrow">COBRANZA · RF-05</span>
<h1>Condición de pago @p?.Codigo</h1>
<p>@p?.Cliente · Total del pedido Bs @p?.Total.ToString("N2"). Se acuerda por operación: no hay plazo por defecto.</p>
</div><a class="button secondary" href="/Pedidos/Detalle/@Model.PedidoId">Volver al pedido</a>
</div>
<div class="notice" role="note">Autorizar crédito <b>no cobra ni liquida</b> la deuda: solo permite despachar con saldo pendiente hasta el vencimiento acordado.</div>
<section class="card form-card">
<h2>Registrar condición acordada</h2>
<form method="post">
<div asp-validation-summary="All" class="validation" role="alert"></div>
<input asp-for="PedidoId" type="hidden"/>
<div class="form-grid">
<div class="field"><label asp-for="Modalidad">Modalidad</label><select asp-for="Modalidad"><option value="CONTADO">Contado</option><option value="CREDITO_ACORDADO">Crédito acordado</option></select></div>
<div class="field"><label asp-for="ImporteAutorizado">Importe de crédito · Bs</label><input asp-for="ImporteAutorizado" type="number" min="0" step="0.01" value="@Model.ImporteAutorizado.ToString(System.Globalization.CultureInfo.InvariantCulture)"/><span asp-validation-for="ImporteAutorizado" class="validation"></span><small class="hint">Solo para crédito. Al contado se envía 0.</small></div>
<div class="field"><label asp-for="Vencimiento">Vencimiento · Bolivia</label><input asp-for="Vencimiento" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}"/><span asp-validation-for="Vencimiento" class="validation"></span><small class="hint">Obligatorio para crédito.</small></div>
</div>
<div class="form-actions"><button class="button" type="submit">Registrar condición</button></div>
</form>
</section>
<section class="card">
<h2>Historial de condiciones</h2>
<p class="muted">Sustituir un acuerdo conserva el anterior. Después del despacho no se sustituye.</p>
@if(Model.Historial.Count==0){<p class="muted">Todavía no hay condición acordada para este pedido.</p>}else{<div class="table-wrap">
<table>
<thead><tr><th>Acordada</th><th>Modalidad</th><th>Importe autorizado</th><th>Vencimiento</th><th>Estado</th></tr></thead>
<tbody>@foreach(var c in Model.Historial){<tr>
<td>@Hora.Mostrar(c.FechaAcuerdo)</td>
<td>@Textos.Condicion(c.Modalidad)</td>
<td>@(c.Modalidad=="CONTADO"?"—":"Bs "+c.ImporteAutorizado.ToString("N2"))</td>
<td>@(c.Vencimiento is null?"—":Hora.Mostrar(c.Vencimiento.Value))</td>
<td><span class="badge @(c.Activa?"":"muted-badge")">@(c.Activa?"Vigente":"Sustituida")</span></td>
</tr>}</tbody>
</table>
</div>}
</section>
