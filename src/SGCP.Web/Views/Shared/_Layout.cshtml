@{ var actual = ViewContext.RouteData.Values["controller"]?.ToString(); var acceso = User.Identity?.IsAuthenticated == true; var cuenta = actual == "Cuenta"; }
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · SGCP</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head>
<body class="@(acceso && !cuenta ? "gestion" : "acceso")"><a class="skip" href="#contenido">Saltar al contenido</a>
@if(acceso && !cuenta){
<aside class="sidebar" id="navegacion"><a href="/" class="brand"><span class="brand-mark">S</span><span>SGCP<small>Gestión comercial porcino</small></span></a>
<p class="nav-label">ESPACIO DE TRABAJO</p>
<nav aria-label="Principal">
<a class="@(actual=="Inicio"?"active":"")" href="/"><span class="nav-icon">◫</span>Resumen</a>
@foreach(var item in new[]{("Usuarios","Usuarios","usuarios.consultar"),("Clientes","Clientes","clientes.consultar"),("Productos","Productos","catalogo.consultar"),("Precios","Gestión de costos","costos.consultar"),("Cotizaciones","Cotizaciones","cotizaciones.consultar"),("Pedidos","Pedidos","pedidos.consultar")}){if(User.HasClaim("permiso",item.Item3)){<a class="@(actual==item.Item1||actual=="Clasificaciones"&&item.Item1=="Productos"?"active":"")" href="/@item.Item1"><span class="nav-icon">◇</span>@item.Item2</a>}}
@if(!User.IsInRole("COMPRADOR")){<p class="nav-label">PRÓXIMAS ETAPAS</p>@foreach(var nombre in new[]{"Producción","Inventario","Cobranza","Transporte / entregas","Reportes"}){<span class="nav-disabled" aria-disabled="true"><span class="nav-icon">·</span>@nombre<small>Pendiente</small></span>}}
</nav><div class="sidebar-foot"><span class="status-dot"></span> Operación con conexión<small>Santa Cruz de la Sierra · Bolivia</small></div></aside>
<div class="shade" id="sombra" hidden>
</div>
<div class="workspace">
<header class="topbar"><button type="button" class="menu-toggle" aria-label="Abrir navegación" aria-controls="navegacion" aria-expanded="false">☰</button><span class="workspace-name">@(User.IsInRole("COMPRADOR")?"Portal del comprador":"Gestión del negocio")</span>
<div class="account"><span class="avatar">@(User.Identity?.Name?.FirstOrDefault())</span><span>@User.Identity?.Name<small>@string.Join(" · ",User.FindAll("rol").Select(x=>x.Value.Replace('_',' ')))</small></span>
<form asp-controller="Cuenta" asp-action="Salir" method="post"><button class="text-button" type="submit">Salir</button>
</form>
</div>
</header>
<main id="contenido" tabindex="-1"><partial name="_Mensajes"/>@RenderBody()</main>
<footer class="footer"><span>SGCP · Gestión comercial y clientes</span><span>Importes en bolivianos · Hora de Bolivia</span>
</footer>
</div>
}else{
<div class="auth-shell">
<aside class="auth-brand"><a href="/" class="brand"><span class="brand-mark">S</span><span>SGCP<small>Gestión comercial porcino</small></span></a>
<div class="auth-story"><span class="eyebrow">DEL ACUERDO AL PEDIDO</span>
<h1>Tu operación,<br/>en buen orden.</h1>
<p>Clientes, productos y acuerdos comerciales en un mismo lugar.</p>
<div class="story-steps"><span><b>01</b> Organiza tu catálogo</span><span><b>02</b> Conserva cada acuerdo</span><span><b>03</b> Sigue tus pedidos</span>
</div>
</div><small>Santa Cruz de la Sierra · Bolivia</small>
</aside>
<main id="contenido" class="auth-main">
<div class="auth-form"><partial name="_Mensajes"/>@RenderBody()</div>
</main>
</div>
}
<script src="~/js/site.js" asp-append-version="true" defer></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
