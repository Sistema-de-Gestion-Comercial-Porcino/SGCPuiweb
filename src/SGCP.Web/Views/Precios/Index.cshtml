@model ListaViewModel<ProductoDto>
@{ViewData["Title"]="Costos y precios";ViewData["Pagina"]=Model.Datos.PaginaNumero;ViewData["TotalPaginas"]=Model.Datos.TotalPaginas;ViewData["TotalRegistros"]=Model.Datos.TotalRegistros;}
<div class="page-head">
<div><span class="eyebrow">GESTIÓN COMERCIAL</span>
<h1>Costos y precios</h1>
<p>Vigencias por producto. Los acuerdos confirmados se conservan.</p>
</div>
<div class="actions">
</div>
</div>
<section class="card">
<form method="get" class="filters">
<div class="search-field"><label for="busqueda" class="sr-only">Buscar</label><input id="busqueda" name="busqueda" value="@Model.Busqueda" placeholder="Buscar por nombre o código…"/>
</div><label class="sr-only" for="tamanoPagina">Registros por página</label><select id="tamanoPagina" name="tamanoPagina">@foreach(var n in new[]{10,20,50,100}){<option value="@n" selected="@(Model.Datos.TamanoPagina==n)">@n por página</option>}</select><button class="button secondary small">Buscar</button><a asp-action="Index" class="text-link">Limpiar</a>
</form>
@if(Model.Datos.Elementos.Count==0){<div class="empty"><span class="empty-mark">⌕</span>
<h3>No hay registros para mostrar</h3>
<p>Prueba otra búsqueda o crea el primer registro si tienes permiso.</p>
</div>}else{<div class="table-wrap">
<table>
<thead>
<tr>
<th>Producto</th>
<th>Unidad</th>
<th>Costo vigente</th>
<th>Precio vigente</th>
<th>Acciones</th>
</tr>
</thead>
<tbody>@foreach(var x in Model.Datos.Elementos){<tr>
<td><span class="strong">@x.Nombre</span><small>@x.Codigo</small>
</td>
<td>@x.UnidadVenta</td>
<td>@(x.PrecioVigente?.CostoReferencia is null?"Sin vigencia":"Bs "+x.PrecioVigente.CostoReferencia.Value.ToString("N2"))</td>
<td>@(x.PrecioVigente is null?"Sin vigencia":"Bs "+x.PrecioVigente.PrecioVenta.ToString("N2"))</td>
<td><a asp-action="Historial" asp-route-id="@x.Id">Ver vigencias →</a>
</td>
</tr>}</tbody>
</table>
</div>}
<partial name="_Paginacion"/></section>
