@model FichaViewModel<CotizacionDto>
@{var c=Model.Datos;ViewData["Title"]=c.Codigo;var vigente=c.VigenteHasta>DateTime.UtcNow&&c.VersionPosterior is null;}
<div class="page-head">
<div><span class="eyebrow">COTIZACIÓN · VERSIÓN @c.Version</span>
<h1>@c.Codigo <span class="badge">@(c.PendienteRevision ? "PENDIENTE DE REVISIÓN" : c.Estado)</span>
</h1>
<p>@c.Cliente · @(c.PendienteRevision ? "Solicitud enviada a Ventas" : "Válida hasta " + Hora.Mostrar(c.VigenteHasta))</p>
</div><a class="button secondary" href="/Cotizaciones">Volver al listado</a>
</div>
@if(c.VersionPosterior is not null){<div class="notice">Existe una versión más reciente: <a href="/Cotizaciones/Detalle/@c.VersionPosterior.Id">@c.VersionPosterior.Codigo · versión @c.VersionPosterior.Version</a>.</div>}
@if(c.CotizacionOrigenId is not null){<p><a asp-action="Detalle" asp-route-id="@c.CotizacionOrigenId">← Consultar versión anterior</a></p>}
@if(User.IsInRole("COMPRADOR")){
    @if(c.PendienteRevision || c.Estado=="BORRADOR"){
        <div class="notice">Ventas está revisando tu solicitud. Cuando presente la cotización, aparecerá el botón «Aceptar cotización». Los importes de referencia todavía pueden cambiar.</div>
    }else if(c.Estado=="PRESENTADA" && vigente){
        <div class="notice">Ventas ya presentó tu cotización. Revisa los precios y cantidades; después pulsa «Aceptar cotización» o solicita cambios.</div>
    }else if(c.Estado=="ACEPTADA" && c.PedidoId is null){
        <div class="notice">Ya aceptaste la cotización. El siguiente paso corresponde a Ventas: confirmar tu pedido. Después podrás verlo en «Pedidos».</div>
    }
}
<section class="card">
<div class="card-head">
<h2>@(c.PendienteRevision ? "Productos solicitados" : "Productos cotizados")</h2><span class="tag">Canal @c.Canal</span>
</div>
<div class="table-wrap">
<table>
<thead>
<tr>
<th>Producto</th>
<th>Cantidad</th>
<th>@(c.PendienteRevision ? "Precio de referencia" : "Precio acordado")</th>
<th>@(c.PendienteRevision ? "Subtotal estimado" : "Importe")</th>
</tr>
</thead>
<tbody>@foreach(var x in c.Detalles){<tr>
<td class="strong">@x.Producto</td>
<td>@x.Cantidad.ToString("0.###") @x.Unidad</td>
<td>@((c.PendienteRevision ? x.PrecioReferencia : x.PrecioUnitario) is decimal precio ? $"Bs {precio:N2}/{x.Unidad}" : "Por cotizar")</td>
<td>@((c.PendienteRevision ? x.SubtotalReferencia : x.Subtotal) is decimal subtotal ? $"Bs {subtotal:N2}" : "Por cotizar")</td>
</tr>}</tbody>
</table>
</div>
<div class="total-row"><span>@(c.PendienteRevision ? "Total estimado" : "Total de productos")</span><strong>@((c.PendienteRevision ? c.TotalReferencia : c.Total) is decimal total ? $"Bs {total:N2}" : "Hay productos por cotizar")</strong>
</div>
@if(!string.IsNullOrWhiteSpace(c.MotivoRespuesta)){<div class="notice"><b>Respuesta del cliente:</b> @c.MotivoRespuesta</div>}
<div class="actions wrap">@if(c.Estado=="BORRADOR"&&User.HasClaim("permiso","cotizaciones.administrar")){<a class="button secondary" asp-action="Formulario" asp-route-id="@c.Id">Editar borrador</a>
@if(!c.PendienteRevision){<form asp-action="Presentar" method="post"><input name="id" value="@c.Id" type="hidden"/><button class="button">Presentar cotización</button></form>}}
@if(c.PendienteRevision && User.IsInRole("COMPRADOR") && User.HasClaim("permiso","cotizaciones.solicitar")){<a class="button secondary" asp-action="Solicitar" asp-route-id="@c.Id">Modificar solicitud</a>}
@if(c.Estado=="PRESENTADA"&&vigente&&User.HasClaim("permiso","cotizaciones.responder")){<a class="button" asp-action="Responder" asp-route-id="@c.Id" asp-route-valor="aceptar">@(User.IsInRole("COMPRADOR") ? "Aceptar cotización" : "Registrar aceptación")</a><a class="button secondary" asp-action="Responder" asp-route-id="@c.Id" asp-route-valor="rechazar">@(User.IsInRole("COMPRADOR") ? "Solicitar cambios / rechazar" : "Registrar rechazo / cambios")</a>}
@if(c.Estado!="BORRADOR"&&c.PedidoId is null&&c.VersionPosterior is null&&User.HasClaim("permiso","cotizaciones.administrar")){<a class="button secondary" asp-action="NuevaVersion" asp-route-id="@c.Id">Preparar nueva versión</a>}
@if(c.PedidoId is not null){<a class="button" href="/Pedidos/Detalle/@c.PedidoId">Ver pedido confirmado →</a>}else if(User.HasClaim("permiso","pedidos.administrar")){if(c.Estado=="ACEPTADA"&&vigente){<a class="button" href="/Pedidos/Confirmar?cotizacionId=@c.Id">Crear pedido confirmado →</a>}else{<button class="button" disabled>Crear pedido</button>}}
</div><p class="hint">Una cotización rechazada o vencida no genera pedido. No se reserva producto ni se inicia preparación.</p></section>
