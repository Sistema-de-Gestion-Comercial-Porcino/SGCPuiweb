@model ListaViewModel<CotizacionDto>
@{ViewData["Title"]="Cotizaciones";ViewData["Pagina"]=Model.Datos.PaginaNumero;ViewData["TotalPaginas"]=Model.Datos.TotalPaginas;ViewData["TotalRegistros"]=Model.Datos.TotalRegistros;}
<div class="page-head">
<div><span class="eyebrow">GESTIÓN COMERCIAL</span>
<h1>Cotizaciones</h1>
<p>Primero el acuerdo. Después, el pedido.</p>
</div>
<div class="actions">@if(User.HasClaim("permiso","cotizaciones.administrar")){<a class="button" asp-action="Formulario">+ Crear registro</a>}</div>
</div>
<section class="card">
<form method="get" class="filters">
<div class="search-field"><label for="busqueda" class="sr-only">Buscar</label><input id="busqueda" name="busqueda" value="@Model.Busqueda" placeholder="Buscar por nombre o código…"/>
</div><select asp-for="Filtro" name="filtro" aria-label="Estado"><option value="">Todos los estados</option>@foreach(var s in new[]{"BORRADOR","PRESENTADA","ACEPTADA","RECHAZADA","VENCIDA"}){<option>@s</option>}</select><label class="sr-only" for="tamanoPagina">Registros por página</label><select id="tamanoPagina" name="tamanoPagina">@foreach(var n in new[]{10,20,50,100}){<option value="@n" selected="@(Model.Datos.TamanoPagina==n)">@n por página</option>}</select><button class="button secondary small">Buscar</button><a asp-action="Index" class="text-link">Limpiar</a>
</form>
@if(Model.Datos.Elementos.Count==0){<div class="empty"><span class="empty-mark">⌕</span>
<h3>No hay registros para mostrar</h3>
<p>Prueba otra búsqueda o crea el primer registro si tienes permiso.</p>
</div>}else{<div class="table-wrap">
<table>
<thead>
<tr>
<th>Cotización</th>
<th>Cliente</th>
<th>Creada</th>
<th>Vigencia</th>
<th>Estado</th>
<th>Acciones</th>
</tr>
</thead>
<tbody>@foreach(var x in Model.Datos.Elementos){<tr>
<td><a class="code" asp-action="Detalle" asp-route-id="@x.Id">@x.Codigo</a><small>Versión @x.Version</small>
</td>
<td>@x.Cliente</td>
<td>@Hora.Mostrar(x.Fecha)</td>
<td>@Hora.Mostrar(x.VigenteHasta)</td>
<td><span class="badge">@x.Estado</span>
</td>
<td><a asp-action="Detalle" asp-route-id="@x.Id">Abrir →</a>
</td>
</tr>}</tbody>
</table>
</div>}
<partial name="_Paginacion"/></section>
