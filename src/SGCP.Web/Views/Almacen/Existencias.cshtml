@model ListaViewModel<ExistenciaDto>
@{ViewData["Title"]="Existencias";ViewData["Pagina"]=Model.Datos.PaginaNumero;ViewData["TotalPaginas"]=Model.Datos.TotalPaginas;ViewData["TotalRegistros"]=Model.Datos.TotalRegistros;}
<div class="page-head">
<div><span class="eyebrow">ALMACÉN</span>
<h1>Existencias</h1>
<p>Stock físico por producto y lote. Disponible = física apta − reservada.</p>
</div>
<div class="actions">@if(User.HasClaim("permiso","inventario.administrar")){<a class="button secondary" asp-action="Pedidos">Pedidos por preparar</a><a class="button secondary" asp-action="Pesajes">Pesajes</a><a class="button secondary" asp-action="Entradas">Entradas físicas</a>}</div>
</div>
<section class="card">
<form method="get" class="filters">
<label class="sr-only" for="productoId">Producto</label><select id="productoId" name="productoId"><option value="">Todos los productos</option>@foreach(var p in Model.Opciones){<option value="@p.Id" selected="@(Model.Filtro==p.Id.ToString())">@p.Nombre</option>}</select><label class="sr-only" for="tamanoPagina">Registros por página</label><select id="tamanoPagina" name="tamanoPagina">@foreach(var n in new[]{10,20,50,100}){<option value="@n" selected="@(Model.Datos.TamanoPagina==n)">@n por página</option>}</select><button class="button secondary small">Filtrar</button><a asp-action="Existencias" class="text-link">Limpiar</a>
</form>
@if(Model.Datos.Elementos.Count==0){<div class="empty"><span class="empty-mark">⌕</span>
<h3>No hay existencias</h3>
<p>El stock solo aparece cuando almacén confirma la entrada física de un lote pesado. Las órdenes planificadas no suman aquí.</p>
</div>}else{<div class="table-wrap">
<table>
<thead><tr><th>Producto</th><th>Lote</th><th>Ubicación</th><th>Física apta</th><th>Reservada</th><th>Disponible</th><th>Estado</th><th>Historial</th></tr></thead>
<tbody>@foreach(var x in Model.Datos.Elementos){var vencido=x.Vencimiento<=DateTime.UtcNow;var apto=x.Estado=="APTO"&&!vencido;<tr>
<td class="strong">@x.Producto</td>
<td>@x.Lote<small>Vence @Hora.Mostrar(x.Vencimiento)</small></td>
<td>@x.Ubicacion</td>
<td>@x.CantidadFisica.ToString("0.###") @x.Unidad</td>
<td>@x.Reservada.ToString("0.###") @x.Unidad</td>
<td class="strong">@x.Disponible.ToString("0.###") @x.Unidad<small>@(apto?x.CantidadFisica.ToString("0.###")+" − "+x.Reservada.ToString("0.###"):"No disponible")</small></td>
<td><span class="badge @(apto?"":"danger")">@(vencido?"VENCIDO":x.Estado)</span></td>
<td><a class="text-link" asp-action="Movimientos" asp-route-id="@x.Id">Movimientos</a></td>
</tr>}</tbody>
</table>
</div>}
<p class="hint">No se muestran cantidades previstas ni planificadas: solo lo que físicamente entró al almacén. Un lote bloqueado o vencido tiene disponible 0.</p>
<partial name="_Paginacion"/></section>
