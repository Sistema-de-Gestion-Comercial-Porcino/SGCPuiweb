@model PesajeListaViewModel
@{ViewData["Title"]="Pesajes";ViewData["Pagina"]=Model.Datos.PaginaNumero;ViewData["TotalPaginas"]=Model.Datos.TotalPaginas;ViewData["TotalRegistros"]=Model.Datos.TotalRegistros;}
<div class="page-head">
<div><span class="eyebrow">ALMACÉN · PASO 1 DE 2</span>
<h1>Pesajes</h1>
<p>Registrar el peso no da de alta la existencia. El stock sube recién con la entrada física.</p>
</div>
<div class="actions"><a class="button" asp-action="Pesar">+ Registrar pesaje</a><a class="button secondary" asp-action="Entradas">Entradas físicas</a></div>
</div>
<section class="card">
@if(Model.Datos.Elementos.Count==0){<div class="empty"><span class="empty-mark">⌕</span><h3>Sin pesajes</h3><p>Los lotes confirmados en producción esperan su pesaje.</p></div>}else{<div class="table-wrap">
<table>
<thead><tr><th>Lote</th><th>Producto</th><th>Bruto</th><th>Tara</th><th>Neto</th><th>Responsable</th><th>Fecha</th><th>Entrada física</th></tr></thead>
<tbody>@foreach(var x in Model.Datos.Elementos){var lote=Model.Lotes.GetValueOrDefault(x.LoteId);<tr>
<td class="strong">@(lote?.Codigo??"—")</td>
<td>@(Model.Productos.TryGetValue(x.ProductoId,out var p)?p.Nombre:"—")</td>
<td>@x.PesoBruto.ToString("0.###") @x.Unidad</td>
<td>@x.Tara.ToString("0.###") @x.Unidad</td>
<td class="strong">@x.Neto.ToString("0.###") @x.Unidad</td>
<td>@SGCP.Web.Services.Nombres.Responsable(Model.Nombres,x.ResponsableId)</td>
<td>@Hora.Mostrar(x.Fecha)</td>
<td>@if(Model.ConEntrada.Contains(x.Id)){<span class="badge">Confirmada</span>}else{<a class="button secondary small" asp-action="Entrada" asp-route-pesajeId="@x.Id">Confirmar entrada</a>}</td>
</tr>}</tbody>
</table>
</div>}
<partial name="_Paginacion"/></section>
