@model PedidosPorPrepararViewModel
@{ViewData["Title"]="Pedidos por preparar";ViewData["Pagina"]=Model.Pagina;ViewData["TotalPaginas"]=Model.TotalPaginas;ViewData["TotalRegistros"]=Model.TotalRegistros;}
<div class="page-head">
<div><span class="eyebrow">ALMACÉN · RESERVAS</span>
<h1>Pedidos por preparar</h1>
<p>Pedidos confirmados que todavía no salieron. Cada producto se reserva desde una existencia física apta; sin la reserva completa no se puede preparar la entrega.</p>
</div>
<div class="actions"><a class="button secondary" asp-action="Existencias">Existencias</a></div>
</div>
<div class="notice" role="note"><b>Solo se reserva stock que entró físicamente.</b> Las cantidades previstas de una orden de producción no aparecen aquí: no son existencia.</div>
<section class="card">
<form method="get" class="filters">
<label class="sr-only" for="busqueda">Pedido o cliente</label><input id="busqueda" name="busqueda" value="@Model.Busqueda" placeholder="Código de pedido o cliente"/>
<label class="sr-only" for="estado">Reserva</label><select id="estado" name="estado">@foreach(var (v,t) in new[]{("pendientes","Con reserva pendiente"),("completos","Reserva completa"),("todos","Todos")}){<option value="@v" selected="@(Model.Estado==v)">@t</option>}</select>
<label class="sr-only" for="tamanoPagina">Registros por página</label><select id="tamanoPagina" name="tamanoPagina">@foreach(var n in new[]{10,20,50,100}){<option value="@n" selected="@(Model.TamanoPagina==n)">@n por página</option>}</select>
<button class="button secondary small">Filtrar</button><a asp-action="Pedidos" class="text-link">Limpiar</a>
</form>
@if(Model.Pedidos.Count==0){<div class="empty"><span class="empty-mark">✓</span>
<h3>@(Model.Busqueda!=""?"Ningún pedido coincide con la búsqueda":Model.Estado=="pendientes"?"No hay pedidos con reserva pendiente":"No hay pedidos por preparar")</h3>
<p>Los pedidos aparecen aquí cuando Ventas los confirma y desaparecen cuando su entrega sale.</p>
</div>}else{<div class="table-wrap">
<table class="tabla-preparar">
<thead><tr><th>Pedido</th><th>Comprometido</th><th>Productos (reservado / confirmado)</th><th>Reserva</th><th>Acciones</th></tr></thead>
<tbody>@foreach(var p in Model.Pedidos){var activas=p.Detalles.SelectMany(d=>d.Reservas).Count();<tr id="pedido-@p.Pedido.Id">
<td><span class="strong">@p.Pedido.Codigo</span><small>@p.Pedido.Cliente</small></td>
<td>@Hora.Mostrar(p.Pedido.FechaComprometida)<small>Preparación: @p.Pedido.EstadoPreparacion</small></td>
<td><ul class="plain">@foreach(var d in p.Detalles){<li><span class="strong">@d.Detalle.Producto</span> · @d.Reservado.ToString("0.###") / @d.Detalle.CantidadConfirmada.ToString("0.###") @d.Detalle.Unidad
@if(!d.Completo){<text> · </text><a class="text-link" asp-action="Reservar" asp-route-pedidoId="@p.Pedido.Id" asp-route-detalleId="@d.Detalle.Id">Reservar @d.Falta.ToString("0.###") @d.Detalle.Unidad</a>}</li>}</ul>
@if(activas>0){<details class="reservas"><summary>Ver reservas (@activas)</summary><ul class="plain">@foreach(var d in p.Detalles){foreach(var r in d.Reservas){var ex=Model.Existencias.TryGetValue(r.ExistenciaId,out var e)?e:null;<li>
@d.Detalle.Producto · @r.Cantidad.ToString("0.###") @d.Detalle.Unidad · lote @(ex?.Lote??"—")@(ex is null||string.IsNullOrWhiteSpace(ex.Ubicacion)?"":" · "+ex.Ubicacion)
<span class="badge @(r.Estado=="ACTIVA"?"":"muted-badge")">@r.Estado</span>
<small>@SGCP.Web.Services.Nombres.Responsable(Model.Nombres,r.ResponsableId) · @Hora.Mostrar(r.Fecha)@(string.IsNullOrWhiteSpace(r.MotivoLiberacion)?"":" · Motivo: "+r.MotivoLiberacion)</small>
@if(r.Estado=="ACTIVA"){<a class="text-link danger-text" asp-action="Liberar" asp-route-id="@r.Id" asp-route-pedidoId="@p.Pedido.Id">Liberar</a>}
</li>}}</ul></details>}</td>
<td><span class="badge @(p.Completo?"":"muted-badge")">@(p.Completo?"RESERVA COMPLETA":"FALTA RESERVAR")</span></td>
<td class="row-actions">@if(p.Completo&&User.HasClaim("permiso","entregas.atender")&&User.HasClaim("permiso","pedidos.consultar")){<a href="/Entregas/Preparar?pedidoId=@p.Pedido.Id">Preparar entrega</a>}else if(!p.Completo){<span class="muted">Reserva lo que falta</span>}</td>
</tr>}</tbody>
</table>
</div>}
<partial name="_Paginacion"/></section>
