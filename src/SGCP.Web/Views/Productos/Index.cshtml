@model ListaViewModel<ProductoDto>
@{ViewData["Title"]="Productos";var verPrecio=User.HasClaim("permiso","precios.consultar");ViewData["Pagina"]=Model.Datos.PaginaNumero;ViewData["TotalPaginas"]=Model.Datos.TotalPaginas;ViewData["TotalRegistros"]=Model.Datos.TotalRegistros;}
<div class="page-head">
<div><span class="eyebrow">GESTIÓN COMERCIAL</span>
<h1>Productos</h1>
<p>Cortes, derivados e insumos con su presentación y unidad.</p>
@if(User.IsInRole("COMPRADOR") && User.HasClaim("permiso","cotizaciones.solicitar")){<a class="button" href="/Cotizaciones/Solicitar">Solicitar cotización</a>}
</div>
<div class="actions">@if(User.HasClaim("permiso","catalogo.administrar")){<a class="button" asp-action="Formulario">+ Crear registro</a>}@if(User.HasClaim("permiso","catalogo.administrar")){<a class="button secondary" href="/Clasificaciones">Clasificaciones</a>}</div>
</div>
<section class="card">
<form method="get" class="filters">
<div class="search-field"><label for="busqueda" class="sr-only">Buscar</label><input id="busqueda" name="busqueda" value="@Model.Busqueda" placeholder="Buscar por nombre o código…"/>
</div><label class="sr-only" for="filtro">Familia</label><select asp-for="Filtro" id="filtro" name="filtro"><option value="">Todas las familias</option><option value="CARNE_FRESCA">Carne fresca</option><option value="DERIVADO">Derivados</option><option value="INSUMO">Insumos</option></select><label class="sr-only" for="tamanoPagina">Registros por página</label><select id="tamanoPagina" name="tamanoPagina">@foreach(var n in new[]{10,20,50,100}){<option value="@n" selected="@(Model.Datos.TamanoPagina==n)">@n por página</option>}</select><button class="button secondary small">Buscar</button><a asp-action="Index" class="text-link">Limpiar</a>
</form>
@if(Model.Datos.Elementos.Count==0){<div class="empty"><span class="empty-mark">⌕</span>
<h3>No hay registros para mostrar</h3>
<p>Prueba otra búsqueda o crea el primer registro si tienes permiso.</p>
</div>}else{<div class="table-wrap">
<table>
<thead>
<tr>
<th>Producto</th>
<th>Clasificación</th>
<th>Presentación</th>
@if(verPrecio){<th>Precio vigente</th>}
<th>Estado</th>
<th>Acciones</th>
</tr>
</thead>
<tbody>@foreach(var x in Model.Datos.Elementos){<tr>
<td><a class="strong" asp-action="Detalle" asp-route-id="@x.Id">@x.Nombre</a><small>@x.Codigo</small>
</td>
<td>@x.Clasificacion.Nombre<small>@x.Clasificacion.Familia.Replace('_',' ')</small>
</td>
<td>@x.Presentacion · @x.UnidadVenta</td>
@if(verPrecio){<td>@(x.PrecioVigente is null?"Sin vigencia":"Bs "+x.PrecioVigente.PrecioVenta.ToString("N2")+"/"+x.UnidadVenta)</td>}
<td><span class="badge">@(x.Activo?"Activo":"Inactivo")</span>
</td>
<td class="row-actions"><a asp-action="Detalle" asp-route-id="@x.Id">Ver</a>@if(User.HasClaim("permiso","catalogo.administrar")){<a asp-action="Formulario" asp-route-id="@x.Id">Editar</a><a asp-action="Estado" asp-route-id="@x.Id" asp-route-valor="@((!x.Activo).ToString().ToLowerInvariant())">@(x.Activo?"Desactivar":"Activar")</a>}</td>
</tr>}</tbody>
</table>
</div>}
<partial name="_Paginacion"/></section>
