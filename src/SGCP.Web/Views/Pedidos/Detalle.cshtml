@model FichaViewModel<PedidoDto>
@{var p=Model.Datos;ViewData["Title"]=p.Codigo;}<div class="page-head">
<div><span class="eyebrow">PEDIDO CONFIRMADO</span>
<h1>@p.Codigo <span class="badge">@p.EstadoComercial</span>
</h1>
<p>@p.Cliente · Origen <a href="/Cotizaciones/Detalle/@p.CotizacionId">@p.Cotizacion aceptada</a>
</p>
</div><a class="button secondary" href="/Pedidos">Volver al listado</a>
</div>
<section class="card">
<div class="table-wrap">
<table>
<thead>
<tr>
<th>Concepto</th>
<th>Cantidad</th>
<th>Precio acordado</th>
<th>Importe</th>
<th>Preparación</th>
</tr>
</thead>
<tbody>@foreach(var x in p.Detalles){<tr>
<td class="strong">@x.Producto</td>
<td>@x.CantidadConfirmada.ToString("0.###") @x.Unidad</td>
<td>Bs @x.PrecioAcordado.ToString("N2")/@x.Unidad</td>
<td>Bs @x.Subtotal.ToString("N2")</td>
<td>@x.Estado.Replace('_',' ')</td>
</tr>}</tbody>
</table>
</div>
<div class="total-row"><span>Total de productos</span><strong>Bs @p.Total.ToString("N2")</strong>
</div>
<dl class="facts">
<div>
<dt>Fecha comprometida</dt>
<dd>@Hora.Mostrar(p.FechaComprometida)</dd>
</div>
<div>
<dt>Condición de pago</dt>
<dd>@p.CondicionPago.Replace('_',' ')</dd>
</div>
<div>
<dt>Preparación</dt>
<dd>@p.EstadoPreparacion.Replace('_',' ')</dd>
</div>
</dl>
@if(p.MargenEstimadoConfirmado is not null){<div class="margin-card"><span class="eyebrow">INFORMACIÓN INTERNA</span>
<h2>Margen estimado de productos <strong>Bs @p.MargenEstimadoConfirmado.Value.ToString("N2")</strong>
</h2>@foreach(var x in p.Detalles){<p>@x.Producto: @x.CantidadConfirmada.ToString("0.###") @x.Unidad × (Bs @x.PrecioAcordado.ToString("N2") − Bs @x.CostoReferenciaAcordado?.ToString("N2"))</p>}<small>Importes conservados al confirmar. No representa utilidad real por animal.</small>
</div>}
@if(p.EstadoComercial=="CANCELADO"){<div class="notice"><b>Motivo de cancelación:</b> @p.MotivoCancelacion</div>}
@if(p.EstadoComercial=="CONFIRMADO"&&(User.HasClaim("permiso","pagos.administrar")||User.HasClaim("permiso","entregas.administrar"))){<div class="actions wrap">
@if(User.HasClaim("permiso","pagos.administrar")){<a class="button secondary" href="/Cobranza/Condicion?pedidoId=@p.Id">Condición de pago</a><a class="button secondary" href="/Cobranza/Senas?pedidoId=@p.Id">Señas</a><a class="button secondary" href="/Cobranza?clienteId=@p.ClienteId">Saldo del cliente</a>}
@if(User.HasClaim("permiso","entregas.administrar")){<a class="button secondary" href="/Entregas/Preparar?pedidoId=@p.Id">Preparar entrega</a>}
</div><p class="hint">La deuda (cobranza) y la entrega (reparto) avanzan por separado: pagar no marca la entrega y entregar no cobra.</p>}
@if(p.EstadoComercial is "CONFIRMADO" or "CERRADO"){<div class="notice" role="note"><b>Emisión fiscal no habilitada.</b> No hay modalidad ni proveedor fiscal confirmados, así que el sistema no emite comprobantes: la operación comercial se registra igual, sin comprobante fiscal, y la venta sigue su curso.
@if(User.HasClaim("permiso","fiscal.administrar")){if(Model.Fiscal is null){<form method="post" asp-action="RegistroFiscal" asp-route-id="@p.Id" class="row-actions"><button class="button secondary small" type="submit">Registrar operación sin comprobante</button></form>}else{<br/><span>Registrada el @Hora.Mostrar(Model.Fiscal.Fecha) · referencia <b>@Model.Fiscal.ReferenciaUnica</b> · estado @Model.Fiscal.Estado.Replace('_',' '). No es un número fiscal.</span>}}</div>}
<div class="actions wrap">@if(p.EstadoComercial=="CONFIRMADO"&&User.HasClaim("permiso","pedidos.administrar")){<a class="button secondary danger-text" asp-action="Cancelar" asp-route-id="@p.Id">Cancelar pedido</a>}@if(p.EstadoComercial=="CONFIRMADO"&&User.HasClaim("permiso","inventario.administrar")&&User.HasClaim("permiso","operacion.consultar")){<a class="button secondary" href="/Almacen/Pedidos?soloPendientes=false#pedido-@p.Id">Revisar reservas</a>}@if(User.HasClaim("permiso","entregas.administrar")){<a class="button secondary" href="/Entregas">Ver despacho</a>}@if(p.EstadoComercial is "CONFIRMADO" or "CERRADO"&&User.HasClaim("permiso","saldos.consultar")){<a class="button secondary" href="/Constancias/Pedido/@p.Id">Constancia de entrega (PDF)</a>}
</div>
<p class="hint">Las reservas de este pedido se revisan en Almacén · Pedidos por preparar. La preparación se sigue desde Entregas.</p>
</section>
@if(User.HasClaim("permiso","cargos.administrar")){var productos=Model.Cargos.Where(x=>x.Tipo=="PRODUCTO").ToList();var servicios=Model.Cargos.Where(x=>x.Tipo=="SERVICIO").ToList();
<section class="card">
<div class="section-heading"><h2>Cargos del pedido</h2>@if(p.EstadoComercial=="CONFIRMADO"){<a class="button secondary small" asp-action="Servicio" asp-route-id="@p.Id">+ Registrar servicio prestado</a>}</div>
<p class="muted">El producto y el servicio de faeneo o corte se cobran por separado. El servicio solo aparece cuando se acordó y se prestó.</p>
<h3>Cargo por productos</h3>
@if(productos.Count==0){<p class="muted">Sin cargos de producto.</p>}else{<div class="table-wrap"><table><thead><tr><th>Concepto</th><th>Importe</th><th>Estado</th></tr></thead>
<tbody>@foreach(var c in productos){<tr><td>@c.Concepto</td><td>Bs @c.Importe.ToString("N2")</td><td>@(c.Anulado?"Anulado":"Vigente")</td></tr>}</tbody></table></div>
<div class="total-row"><span>Subtotal productos</span><strong>Bs @productos.Where(x=>!x.Anulado).Sum(x=>x.Importe).ToString("N2")</strong></div>}
<h3>Cargo por servicio</h3>
@if(servicios.Count==0){<p class="muted">Este pedido no tiene servicios de faeneo o corte acordados y prestados.</p>}else{<div class="table-wrap"><table><thead><tr><th>Concepto</th><th>Acuerdo</th><th>Prestado</th><th>Importe</th><th>Estado</th></tr></thead>
<tbody>@foreach(var c in servicios){<tr><td>@c.Concepto</td><td>@c.AcuerdoServicio</td><td>@(c.PrestadoEn is null?"—":Hora.Mostrar(c.PrestadoEn.Value))</td><td>Bs @c.Importe.ToString("N2")</td><td>@(c.Anulado?"Anulado":"Vigente")</td></tr>}</tbody></table></div>
<div class="total-row"><span>Subtotal servicios</span><strong>Bs @servicios.Where(x=>!x.Anulado).Sum(x=>x.Importe).ToString("N2")</strong></div>}
</section>}
