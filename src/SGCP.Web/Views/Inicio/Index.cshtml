@model ResumenViewModel
@{ViewData["Title"]="Resumen";var d=Model.Datos;}<div class="page-head">
<div><span class="eyebrow">@(User.IsInRole("COMPRADOR")?"TUS OPERACIONES":"PANORAMA COMERCIAL")</span>
<h1>Todo a la vista</h1>
<p>@Hora.Local(DateTime.UtcNow).ToString("dd 'de' MMMM 'de' yyyy",new CultureInfo("es-BO")) · Chanchería</p>
</div><span class="tag">@(User.IsInRole("COMPRADOR")?"Mi cuenta":"Sprint 1 · Comercial")</span>
</div>
<div class="metrics">@foreach(var item in new[]{("Clientes activos",d.ClientesActivos,"Clientes","Personas y negocios"),("Productos activos",d.ProductosActivos,"Productos","Cortes y derivados"),("Cotizaciones vigentes",d.CotizacionesVigentes,"Cotizaciones","Acuerdos en curso"),("Pedidos confirmados",d.PedidosConfirmados,"Pedidos","Durante este mes")}){if(item.Item2 is not null){<a href="/@item.Item3" class="metric"><span>@item.Item1</span><strong>@item.Item2</strong><small>@item.Item4 <b>↗</b></small></a>}}</div>
<section class="card">
<div class="card-head">
<div>
<h2>Últimos pedidos</h2>
<p>El seguimiento comercial empieza con un acuerdo aceptado.</p>
</div>@if(User.HasClaim("permiso","pedidos.consultar")){<a href="/Pedidos" class="text-link">Ver todos →</a>}</div>
@if(d.UltimosPedidos.Count==0){<div class="empty"><span class="empty-mark">◇</span>
<h3>Aún no hay pedidos para mostrar</h3>
<p>Los pedidos aparecerán cuando se confirme una cotización aceptada.</p>@if(User.HasClaim("permiso","cotizaciones.administrar")){<a class="button secondary" href="/Cotizaciones/Formulario">Preparar cotización</a>}</div>}else{<div class="table-wrap">
<table>
<thead>
<tr>
<th>Pedido</th>
<th>Cliente</th>
<th>Fecha comprometida</th>
<th>Estado</th>
<th>
</th>
</tr>
</thead>
<tbody>@foreach(var x in d.UltimosPedidos){<tr>
<td><a href="/Pedidos/Detalle/@x.Id" class="code">@x.Codigo</a>
</td>
<td>@x.Cliente</td>
<td>@Hora.Mostrar(x.FechaComprometida)</td>
<td><span class="badge">@x.EstadoComercial.Replace('_',' ')</span>
</td>
<td><a href="/Pedidos/Detalle/@x.Id">Ver →</a>
</td>
</tr>}</tbody>
</table>
</div>}</section>
<div class="quick-grid">@if(User.HasClaim("permiso","clientes.administrar")){<a class="quick-card" href="/Clientes/Formulario"><span>+</span>
<div>
<h3>Registrar cliente</h3>
<p>Guarda su contacto y condición habitual.</p>
</div>→</a>}@if(User.HasClaim("permiso","catalogo.administrar")){<a class="quick-card" href="/Productos/Formulario"><span>+</span>
<div>
<h3>Ampliar el catálogo</h3>
<p>Crea productos con presentación y unidad.</p>
</div>→</a>}</div>
