@model ResumenViewModel
@{
    ViewData["Title"] = "Resumen";
    var d = Model.Datos;
}
<div class="dashboard-head page-head">
    <div>
        <span class="eyebrow">@(User.IsInRole("COMPRADOR") ? "TUS OPERACIONES" : "PANORAMA COMERCIAL")</span>
        <h1>Todo a la vista</h1>
        <p>@Hora.Local(DateTime.UtcNow).ToString("dd 'de' MMMM 'de' yyyy", new CultureInfo("es-BO")) · Chanchería</p>
    </div>
    <span class="tag">@(User.IsInRole("COMPRADOR") ? "Mi cuenta" : "Sprint 1 · Comercial")</span>
    <div class="trace-stamp" aria-hidden="true"><span>TRAZABILIDAD</span><svg class="stamp-icon"><use href="/icons.svg#pig"></use></svg><b>SGCP</b><i>SCZ · BOLIVIA</i></div>
</div>

<div class="metrics">
    @foreach (var item in new[]
    {
        (Etiqueta:"Clientes activos", Valor:d.ClientesActivos, Ruta:"Clientes", Detalle:"Personas y negocios", Icono:"users"),
        (Etiqueta:"Productos activos", Valor:d.ProductosActivos, Ruta:"Productos", Detalle:"Cortes y derivados", Icono:"box"),
        (Etiqueta:"Cotizaciones vigentes", Valor:d.CotizacionesVigentes, Ruta:"Cotizaciones", Detalle:"Acuerdos en curso", Icono:"document"),
        (Etiqueta:"Pedidos confirmados", Valor:d.PedidosConfirmados, Ruta:"Pedidos", Detalle:"Durante este mes", Icono:"cart")
    })
    {
        if (item.Valor is not null)
        {
            <a href="/@item.Ruta" class="metric">
                <span class="metric-label"><svg class="metric-icon" aria-hidden="true"><use href="/icons.svg#@item.Icono"></use></svg>@item.Etiqueta</span>
                <strong>@item.Valor</strong>
                <small>@item.Detalle <svg class="metric-arrow" aria-hidden="true"><use href="/icons.svg#arrow-up-right"></use></svg></small>
            </a>
        }
    }
</div>

<section class="card orders-card">
    <div class="card-head">
        <div><h2>Últimos pedidos</h2><p>El seguimiento comercial empieza con un acuerdo aceptado.</p></div>
        @if (User.HasClaim("permiso", "pedidos.consultar"))
        {
            <a href="/Pedidos" class="text-link">Ver todos <svg class="inline-icon" aria-hidden="true"><use href="/icons.svg#arrow-right"></use></svg></a>
        }
    </div>
    @if (d.UltimosPedidos.Count == 0)
    {
        <div class="table-shell empty-table">
            <div class="table-preview" aria-hidden="true"><span>Pedido</span><span>Cliente</span><span>Fecha comprometida</span><span>Estado</span></div>
            <div class="empty">
                <span class="empty-mark"><svg class="icon" aria-hidden="true"><use href="/icons.svg#cart"></use></svg></span>
                <h3>Aún no hay pedidos para mostrar</h3>
                <p>Los pedidos aparecerán cuando se confirme una cotización aceptada.</p>
                @if (User.HasClaim("permiso", "cotizaciones.administrar"))
                {
                    <a class="button accent" href="/Cotizaciones/Formulario">Preparar cotización</a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Pedido</th><th>Cliente</th><th>Fecha comprometida</th><th>Estado</th><th><span class="sr-only">Acciones</span></th></tr></thead>
                <tbody>
                @foreach (var x in d.UltimosPedidos)
                {
                    <tr><td><a href="/Pedidos/Detalle/@x.Id" class="code">@x.Codigo</a></td><td>@x.Cliente</td><td>@Hora.Mostrar(x.FechaComprometida)</td><td><span class="badge">@x.EstadoComercial.Replace('_', ' ')</span></td><td><a href="/Pedidos/Detalle/@x.Id">Ver <span aria-hidden="true">→</span></a></td></tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<div class="quick-grid">
    @if (User.HasClaim("permiso", "clientes.administrar"))
    {
        <a class="quick-card" href="/Clientes/Formulario"><svg class="quick-icon" aria-hidden="true"><use href="/icons.svg#plus-user"></use></svg><div><h3>Registrar cliente</h3><p>Guarda su contacto y condición habitual.</p></div><svg class="quick-arrow" aria-hidden="true"><use href="/icons.svg#arrow-right"></use></svg></a>
    }
    @if (User.HasClaim("permiso", "catalogo.administrar"))
    {
        <a class="quick-card" href="/Productos/Formulario"><svg class="quick-icon" aria-hidden="true"><use href="/icons.svg#box"></use></svg><div><h3>Ampliar el catálogo</h3><p>Crea productos con presentación y unidad.</p></div><svg class="quick-arrow" aria-hidden="true"><use href="/icons.svg#arrow-right"></use></svg></a>
    }
</div>
